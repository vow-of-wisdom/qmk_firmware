  "debounce" : 10,
  "diode_direction" : "COL2ROW",
  "custom_lite" : true,
  "matrix_pins" : {
    "cols" : [ "GP14", "GP13", "GP12", "GP11", "GP10", "GP9" ],
    "rows" : [ "GP8",  "GP7",  "GP6",  "GP5",  "GP4" ]
  },

  "rgblight" : {
    "default"     : { "hue" : 0, "sat" : 0, "val" : 0 },
    "led_count"   : 2,
    "sleep"       : true,
    "split"       : true,
    "split_count" : [ 1, 1 ]
  },

  "split" : {
    "enabled" : true,
    "serial"  : { "driver" : "vendor" },
    "transport" : {
      "protocol" : "serial",
      "watchdog" : true
    }
  },

  "usb" : {
    "device_version" : "0.0.2",
    "no_startup_check" : true,
    "suspend_wakeup_delay" : 500,
    "pid" : "0x4044",
    "vid" : "0x303A"
  },

  "ws2812" : {
    "driver" : "vendor",
    "pin"    : "GP19"
  }
}
